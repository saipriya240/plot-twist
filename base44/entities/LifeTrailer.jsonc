{
  "name": "LifeTrailer",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "script": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "month",
        "season",
        "year",
        "custom"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "gray"
      ]
    },
    "scope_label": {
      "type": "string"
    },
    "memory_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "storyboard": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "photo": {
            "type": "string"
          },
          "line": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}